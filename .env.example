# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings → API). Publishable key is safe in the browser; RLS still applies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used ONLY by scripts/bootstrap.ts and scripts/invite.ts (bypasses RLS).
# Never prefix with NEXT_PUBLIC_, never import it from app code.
SUPABASE_SECRET_KEY=

# Public URL of the app (used in invitation and sign-in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
